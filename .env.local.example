# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Used only by the seed script. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Admin account. The login screen takes a username, which is mapped to an
# email on this internal domain (no email is ever sent to it).
NEXT_PUBLIC_AUTH_DOMAIN=invoicepro.app
ADMIN_USERNAME=YOUR-ADMIN-USERNAME
ADMIN_PASSWORD=YOUR-ADMIN-PASSWORD

# Time zone used for "today", due dates and overdue status
NEXT_PUBLIC_TIMEZONE=Pacific/Fiji
